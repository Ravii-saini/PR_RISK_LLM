# Copy to .env and fill in. Never commit .env (already in .gitignore).

# --- Postgres + pgvector ---
POSTGRES_USER=prriskcopilot
# Note: docker-compose.yml's default (used when POSTGRES_PASSWORD is unset)
# is the username itself. If your pgdata volume was ever initialized before
# this file existed, that default is what's actually baked into the volume
# — match it here rather than changing it, since Postgres only applies
# POSTGRES_PASSWORD on first init of an empty data directory.
POSTGRES_PASSWORD=prriskcopilot
POSTGRES_DB=prriskcopilot
DATABASE_URL=postgresql://prriskcopilot:prriskcopilot@localhost:5432/prriskcopilot

# --- Redis ---
# Host port 6380 (not 6379) — 6379 is already in use by another project's
# container (ratelimiter-redis) on this machine.
REDIS_URL=redis://localhost:6380/0

# --- Dedup / debounce (SPEC §5.1, §6) ---
DEDUP_KEY_TTL_SECONDS=3600
DEBOUNCE_WINDOW_SECONDS=20

# --- GitHub App (SPEC §5.6) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# Comma-separated. If the App is installed on more than one repo, the receiver
# must reject events from any repo not listed here (SPEC §5.1).
ALLOWED_REPOS=your-org/pr-risk-copilot

# --- Local webhook tunnel (dev only, SPEC §"How to use this doc") ---
SMEE_URL=https://smee.io/replace-with-your-channel

# --- LLM (SPEC §5.5) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
GEMINI_API_KEY=
# gemini-2.0-flash has 0 free-tier quota on new accounts as of 2026-08 —
# verify current model availability at aistudio.google.com before changing.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Embeddings (SPEC §5.4) ---
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code

# --- Indexing / scheduled reindex job (SPEC §5.1b) ---
# Comma-separated "owner/name". psf/requests is the eval-target repo
# (Phase 6); the demo-target repo (yours, GitHub App installed) is added
# too so live PR review (Phase 5) has real retrieval context to ground on.
REINDEX_REPOS=psf/requests,your-org/pr-risk-copilot
REINDEX_INTERVAL_MINUTES=15
